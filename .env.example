# Copy this file to .env.local and fill in the values you have.
# The app is designed to run without ANY of these set — Supabase calls are
# skipped gracefully and the AI Assistant falls back to a mock provider —
# so you can start on the UI before setting up a backend.

# --- Supabase (required once you build past onboarding) ---------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, bypasses Row Level Security.
# Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Assistant (optional) -------------------------------------------
# Leave unset to use the built-in mock provider (formatting cleanup only,
# no external calls). Set this to enable real AI-assisted rewriting.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5 if unset.
ALOCV_AI_MODEL=

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
